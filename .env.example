# Reference only: environment variables are NOT automatically read from this file.
MNV2_WEIGHTS=IMAGENET1K_V2
MNV2_DEVICE=cpu
MNV2_HOST=127.0.0.1
MNV2_NUM_THREADS=4
PORT=8501
# Optional trusted, matching ImageNet TorchVision state dict:
# MNV2_CHECKPOINT=/absolute/path/mobilenet_v2.pth
# Behind a reverse proxy, include its hostname:
# MNV2_ALLOWED_HOSTS=localhost,127.0.0.1,lab.example.com
